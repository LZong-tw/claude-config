{
  "cleanupPeriodDays": 999999,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "MAX_CONSECUTIVE_AUTOCOMPACT_FAILURES": "3",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "30",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1"
  },
  "model": "sonnet",
  "language": "zhtw",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(cat:*)",
      "Bash(git log:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(head:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.*)",
      "Read(**/secrets.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/codex-concurrency-gate.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/bash-ps-syntax-guard.cjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/cleanup-serena.cjs\""
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{HOME}}/.claude/hooks/session-healthcheck.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}